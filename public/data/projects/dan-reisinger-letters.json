{"id": "dan-reisinger-letters", "displayTitle": "אותיות ריזינגר", "title": "Dan Reisinger Letters", "editorial": true, "objectType": "Website", "year": 2024, "cover": {"type": "image", "src": "/media/projects/dan-reisinger-letters/work-cover-filled-2712af.webp", "thumb": "/media/projects/dan-reisinger-letters/work-cover-filled-2712af-thumb.webp", "width": 1200, "height": 800, "alt": "אותיות ריזינגר"}, "collaboration": "Hafontia", "productImages": [{"type": "image", "src": "/media/projects/dan-reisinger-letters/work-cover-filled-2712af.webp", "thumb": "/media/projects/dan-reisinger-letters/work-cover-filled-2712af-thumb.webp", "width": 1200, "height": 800, "alt": "אותיות ריזינגר"}], "productDescription": {"blocks": [{"type": "p", "text": "A digital home for Dan Reisinger's letterforms. Initiated by Neil Cohen and Ben Nathan in collaboration with the National Library of Israel, the project brings lettering from Reisinger's archive into contemporary use."}, {"type": "p", "text": "Six Hebrew and Latin type families, spanning fourteen styles, were developed by Ben Nathan at Hafontia from Reisinger's original work. The website connects archival sketches and applications with moving type specimens, inviting visitors to explore, try and download the fonts for free."}]}, "projectContent": [{"blocks": [{"type": "video", "src": "/media/projects/dan-reisinger-letters/reisinger-website-supplied.mp4", "preview": "/media/projects/dan-reisinger-letters/reisinger-website-supplied-preview.mp4", "poster": "/media/projects/dan-reisinger-letters/website-supplied-poster-513cd9.webp", "thumb": "/media/projects/dan-reisinger-letters/website-supplied-poster-513cd9-thumb.webp", "width": 1920, "height": 1104, "alt": "Dan Reisinger Letters website recording supplied by Neil Cohen", "muted": true}, {"type": "image", "src": "/media/projects/dan-reisinger-letters/research-yarden-1-cfe724.webp", "thumb": "/media/projects/dan-reisinger-letters/research-yarden-1-cfe724-thumb.webp", "width": 1500, "h